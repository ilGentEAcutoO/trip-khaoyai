# ── trip-khaoyai · env template ───────────────────────────
# ก็อปไฟล์นี้เป็น .env แล้วเติมค่าจริง: Copy-Item .env.example .env

# Google Cloud API key ที่เปิด Places API (New) แล้ว + ล็อก HTTP referrer
# ใช้ฝั่ง server เท่านั้น (สคริปต์หา place_id + Worker proxy) ห้ามฝังใน frontend
GOOGLE_PLACES_API_KEY=PASTE_YOUR_KEY_HERE

# ความกว้างรูปสูงสุดที่ขอจาก Places Photos (px) — 800 พอสำหรับมือถือ
PLACES_PHOTO_MAX_WIDTH=800
